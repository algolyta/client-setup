  "cmd-sleep": "systemctl suspend",
  "cmd-reboot": "systemctl reboot",
  "cmd-poweroff": "systemctl poweroff",
  "gtk-theme": "Adwaita",
  "gtk-icon-theme": "",
  "gtk-cursor-theme": "Adwaita",
  "prefer-dark-theme": true,
  "template-name": "",
  "time-format": "%H:%M",
  "date-format": "%A, %d. %B",
  "layer": "overlay",
  "keyboard-mode": "on_demand",
  "lang": "",
  "avatar-show": false,
  "env-vars": []
