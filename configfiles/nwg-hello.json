{
  "session_dirs": [
    "/usr/share/wayland-sessions"
  ],
  "custom_sessions": [
    {
      "name": "Hyprland",
      "exec": "Hyprland"
    },
    {
      "name": "Shell",
      "exec": "/usr/bin/bash"
    }
  ],
  "monitor_nums": [],
  "form_on_monitors": [],
