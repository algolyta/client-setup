{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left":   ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right":  ["network", "pulseaudio", "cpu", "memory", "custom/battery", "hyprland/language"],

    // ── Workspaces ──────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
          "1": "1 {{ waybar_workspace_icons.1 }} ",
          "2": "2 {{ waybar_workspace_icons.2 }} ",
          "3": "3 {{ waybar_workspace_icons.3 }} ",
          "4": "4 {{ waybar_workspace_icons.4 }} ",
          "5": "5 {{ waybar_workspace_icons.5 }} ",
          "6": "6 {{ waybar_workspace_icons.6 }} ",
          "7": "7 {{ waybar_workspace_icons.7 }} ",
          "8": "8 {{ waybar_workspace_icons.8 }} ",
          "9": "9 {{ waybar_workspace_icons.9 }} "
        }
    },

    // ── Clock ────────────────────────────────────────────────────
    "clock": {
        "format": " {:%H:%M:%S |  %Y-%m-%d}",
        "tooltip-format": "<big>{:%A, %d %B %Y}</big>\n<tt>{calendar}</tt>",
        "interval": 1
    },

    // ── Network ──────────────────────────────────────────────────
    "network": {
        "format-wifi":        " {essid} ({signalStrength}%)",
        "format-ethernet":    "󰈀 {ipaddr}",
        "format-linked":      "󰈀 {ifname} (no IP)",
        "format-disconnected": "⚠ disconnected",
        "tooltip-format":     "Interface: {ifname}\nIP: {ipaddr}\nGW: {gwaddr}"
    },

    // ── Audio ────────────────────────────────────────────────────
    "pulseaudio": {
        "format":       " {volume}%",
        "format-muted": " muted"
    },

    // ── CPU ──────────────────────────────────────────────────────
    "cpu": {
        "format": " {usage}%"
    },

    // ── Memory ───────────────────────────────────────────────────
    "memory": {
        "format": " {percentage}%"
    },

    // ── Battery ──────────────────────────────────────────────────
    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery.sh",
        "exec-if": "find /sys/class/power_supply -name 'BAT*' | grep -q .",
        "return-type": "json",
        "interval": 30,
        "format": "{}",
        "tooltip": true
    },

    // ── Keyboard layout ──────────────────────────────────────────
    "hyprland/language": {
        "format":        " {}",
        "tooltip":       false
    }
}
