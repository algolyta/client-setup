# ~/.config/i3status/config

general {
    colors = true
    interval = 1
    output_format = i3bar
}

order += "disk /"
order += "wireless wlan0"
order += "ethernet _first_"
order += "cpu_temperature 0"
order += "volume master"
order += "tztime local"

wireless wlan0 {
    format_up = "W: (%quality at %essid, %bitrate / %frequency) %ip"
    format_down = "W: no net"
}

ethernet _first_ {
    format_up = "󱊪 %ip"
    format_down = "󰌙 no net"
}

cpu_temperature 0 {
    format = " %degrees °C"
    path = "/sys/class/thermal/thermal_zone0/temp"
}

disk "/" {
    format = " %avail"
}

volume master {
    format = " %volume"
    format_muted = "󰝟 muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = " %Y-%m-%d %H:%M:%S"
}

